{
	"name": "backend",
	"module": "app.ts",
	"type": "module",
	"version": "1.0.0",
	"description": "",
	"main": ".build/app.js",
	"author": "",
	"license": "ISC",
	"scripts": {
		"start": "nodemon -d 0.5 -w .env -w src -x bun run src/app.ts",
		"start:prod": "bun run src/app.ts",
		"typecheck": "tsc --noEmit",
		"typegen:pg": "env-cmd pgtyped -w -c pgtyped.json",
		"lint": "npx @biomejs/biome check src",
		"lint:fix": "npx @biomejs/biome check --apply src",
		"update": "bun update",
		"update:latest": "bun update --latest"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@pgtyped/cli": "^2.4.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "^1.2.18",
		"@types/pg": "^8.15.4",
		"env-cmd": "^10.1.0"
	},
	"peerDependencies": {
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"@mrspartak/config": "^1.0.0",
		"@onmoon/pg-tx": "^1.0.8",
		"@pgtyped/query": "^2.4.2",
		"pg": "^8.16.3",
		"zod": "^3.25.76"
	}
}
